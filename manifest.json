{
  "schemaVersion": 1,
  "id": "io.github.thebenwalther.wiretap",
  "name": "Wiretap",
  "version": "1.0.0",
  "author": "Ben Walther",
  "license": "MIT",
  "description": "See every socket, grouped by the process that owns it.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Wiretap",
    "description": "Network connections grouped by process.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollOpenSeconds": 2,
      "pollIdleSeconds": 5,
      "hideSystem": true,
      "hideUnix": true,
      "hideUnconnectedUdp": true,
      "showListenOnBar": false,
      "scope": "all"
    },
    "schema": [
      {
        "key": "pollOpenSeconds",
        "type": "integer",
        "label": "Open refresh (seconds)",
        "description": "How often to rescan sockets while the panel is open.",
        "min": 1,
        "max": 5,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "pollIdleSeconds",
        "type": "integer",
        "label": "Idle refresh (seconds)",
        "description": "How often to rescan sockets while the panel is closed.",
        "min": 3,
        "max": 30,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "hideSystem",
        "type": "boolean",
        "label": "Hide system processes",
        "description": "Hide sockets owned by systemd system.slice units (resolved, NetworkManager, …).",
        "defaultValue": true
      },
      {
        "key": "hideUnix",
        "type": "boolean",
        "label": "Hide Unix sockets",
        "defaultValue": true
      },
      {
        "key": "hideUnconnectedUdp",
        "type": "boolean",
        "label": "Hide unconnected UDP",
        "description": "Hide UNCONN UDP (mDNS, discovery, QUIC holes) until you ask for them.",
        "defaultValue": true
      },
      {
        "key": "showListenOnBar",
        "type": "boolean",
        "label": "Show listener count on the bar",
        "defaultValue": false
      },
      {
        "key": "scope",
        "type": "enum",
        "label": "Default scope",
        "options": [
          "all",
          "established",
          "listening",
          "internet",
          "local"
        ],
        "defaultValue": "all"
      }
    ]
  }
}
